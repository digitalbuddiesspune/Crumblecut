# Airpay V3 (UPI QR) — https://docs.airpay.co.in/v3/upi/generate-qr/
AIRPAY_MERCHANT_ID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_SECRET=
# Optional (V4 OAuth — not used by V3 flow)
AIRPAY_CLIENT_ID=
AIRPAY_CLIENT_SECRET=
# Domain whitelisted with Airpay (used as mer_dom base64)
AIRPAY_MER_DOM=https://www.crumblecut.in
# Browser/response callback configured with Airpay (iSmartPay webhook)
AIRPAY_RESPONSE_URL=https://pay.ismartpay.co.in/api/webhook/response/6a551e3266d3d75ac144155e
# Your S2S IPN endpoint (Airpay posts here)
# https://api.crumblecut.in/api/payment/airpay/ipn
BACKEND_URL=https://api.crumblecut.in
FRONTEND_URL=https://www.crumblecut.in

# MSG91 OTP — https://docs.msg91.com/otp
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_BRAND_NAME=Crumblecut
MSG91_DEBUG=false
MSG91_USE_SENDER=false
